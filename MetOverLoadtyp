Problem: Method overloading explained through type of parameters.
import java.util.Scanner;
public class MethoOverLoadingTyP{

	public static void main(String args[]){

		Scanner sc=new Scanner(System.in);
		System.out.println("sum of two numbers is: "+sum(3,6));
		System.out.println("sum of three numbers is: "+sum(9,6.7,8.9));

		
		
		
		
		
		
		
	}

	public static double sum(int a, double b, double c){

		return a+b+c;



	}

	public static int sum(int a, int b){

		return a+b;



	}

}
